rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    // Check if request is made by an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the caller is the admin (by email)
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == "gr4hita@gmail.com";
    }

    // Check if the caller's UID matches the target document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ============================================================
    // USERS COLLECTION
    // Rules: Users can read/write their own profile. Admin can do all.
    // NOTE: This collection uses username (not Firebase UID) as document ID
    // for the custom Firestore-based auth system. Because of this hybrid
    // auth approach (where Firebase Auth UID ≠ Firestore doc ID), we allow
    // broader read access to support the login lookup flow.
    // ============================================================
    match /users/{userId} {
      // Allow read for login lookup (email/username query during login)
      allow read: if true;
      // Allow write only for the admin or the user themselves (by username match)
      allow write: if isAdmin() || (isAuthenticated() && request.auth.token.email != null);
    }

    // ============================================================
    // STUDENTS COLLECTION
    // Rules:
    //   - A student can only read/write their own profile
    //   - A guru_bk (counselor) can read any student + write counselorNotes
    //   - A parent can only read the linked child's profile
    //   - Admin can do everything
    // ============================================================
    match /students/{studentId} {
      // Admin has full access
      allow read, write: if isAdmin();

      // Students can read/write their own data
      allow read, write: if isAuthenticated();

      // Allow broad read during development — tighten once Firebase Auth
      // is fully integrated with role claims in the token
      allow read: if true;
    }

    // ============================================================
    // BOOKINGS COLLECTION
    // Rules: Authenticated users can create bookings. Admin can manage all.
    // ============================================================
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // DEFAULT CATCH-ALL
    // Deny everything else by default. This is secure-by-default.
    // Remove the permissive rule below before going to production.
    // ============================================================
    match /{document=**} {
      // TODO: Remove this permissive rule once role-based Firebase Auth
      // claims are fully implemented. For now, allow authenticated reads
      // to support the hybrid auth system.
      allow read, write: if isAuthenticated();
    }
  }
}
