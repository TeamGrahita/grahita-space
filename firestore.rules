rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // Identity comes from Firebase Auth. Each signed-in user has a
    // profile at users/{uid} (no password) that holds role/username.
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin is identified by a verified email (Google sign-in is verified),
    // never by a role field a user could write themselves.
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == "gr4hita@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return isAuthenticated() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function hasRole(role) {
      return hasProfile() && profile().role == role;
    }

    function isStudentOwner(studentId) {
      return hasRole("siswa") && profile().username == studentId;
    }

    function isParentOf(studentId) {
      return hasRole("orang_tua") && profile().get("childUsername", "") == studentId;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function legacyUserPath(username) {
      return /databases/$(database)/documents/users/$(username);
    }

    // ============================================================
    // USERS COLLECTION
    //   users/{uid}       — profile of a Firebase Auth user (no password)
    //   users/{username}  — LEGACY account with a plaintext `password`.
    //                        Readable so it can be migrated to Firebase
    //                        Auth on first login, then deleted by its owner.
    // ============================================================
    match /users/{userId} {
      allow get: if isAdmin()
        || (isAuthenticated() && request.auth.uid == userId)
        || resource == null
        || ("password" in resource.data);
      allow list: if isAdmin();

      // A user may create only their own profile, without a password field,
      // with a non-admin role and a username they claimed in the same batch.
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        !("password" in request.resource.data) &&
        request.resource.data.role in ["siswa", "guru_bk", "orang_tua"] &&
        getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId
      );

      // Role, username and child link cannot be changed by the user afterwards.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        !("password" in resource.data) &&
        onlyChanges(["fullName", "preferredLanguage"])
      );

      // Owners delete their legacy (password) document once migrated.
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        ("password" in resource.data) &&
        resource.data.email == request.auth.token.email
      );
    }

    // ============================================================
    // USERNAMES COLLECTION — usernames/{username} = { uid, email }
    // Public lookup so people can log in with a username.
    // ============================================================
    match /usernames/{username} {
      allow get: if true;
      allow list: if isAdmin();

      // Claiming a username that still belongs to a legacy account is only
      // allowed for the owner of that legacy account (same email).
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        (!exists(legacyUserPath(username)) ||
          get(legacyUserPath(username)).data.get("email", "") == request.auth.token.email)
      );
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // ============================================================
    // STUDENTS COLLECTION — students/{username}
    //   - siswa: own profile; may update biometrics, band status, questionnaires
    //   - guru_bk: all students; may add notes and use the band simulator
    //   - orang_tua: linked child only; may use the band simulator
    //   - admin: everything
    // ============================================================
    match /students/{studentId} {
      allow read: if isAdmin()
        || hasRole("guru_bk")
        || isStudentOwner(studentId)
        || isParentOf(studentId);

      allow create: if isAdmin() || hasRole("guru_bk") || isStudentOwner(studentId);

      allow update: if isAdmin()
        || (isStudentOwner(studentId) && onlyChanges(["biometricsHistory", "isConnected", "questionnaires"]))
        || (hasRole("guru_bk") && onlyChanges(["counselorNotes", "biometricsHistory", "isConnected"]))
        || (isParentOf(studentId) && onlyChanges(["biometricsHistory", "isConnected"]));

      allow delete: if isAdmin();
    }

    // ============================================================
    // BOOKINGS COLLECTION
    // A student sees and creates only their own bookings.
    // ============================================================
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || hasRole("guru_bk")
        || (hasProfile() && resource.data.get("studentUsername", "") == profile().username);
      allow create: if hasRole("siswa") && request.resource.data.studentUsername == profile().username;
      allow update, delete: if isAdmin();
    }

    // Everything else is denied by default.
  }
}
