# ==========================================
# GRAHITA SPACE — Environment Variables
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to Git.

# ----------------------------------------
# Gemini AI API Key (for Graphite AI Chat)
# Get your key from: https://aistudio.google.com/app/apikey
# ----------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"
# Optional: override the Gemini model (default: gemini-flash-latest)
# GEMINI_MODEL="gemini-2.5-flash"

# ----------------------------------------
# Firebase Configuration
# Get these from: Firebase Console → Project Settings → Your Apps
# ----------------------------------------
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id"

# ----------------------------------------
# App URL (set automatically by Vercel in production)
# ----------------------------------------
APP_URL="http://localhost:3000"
